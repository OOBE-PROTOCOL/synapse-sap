{
  "name": "synapse-agent-sap",
  "version": "1.0.1",
  "description": "SAP v2 — Synapse Agent Protocol: On-chain agent identity, reputation & discovery",
  "license": "MIT",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "sync:idl": "node scripts/sync-idl-artifacts.mjs",
    "verify:idl": "node scripts/verify-idl-artifacts.mjs",
    "verify:idl:checked-in": "node scripts/verify-idl-artifacts.mjs --checked-in-only",
    "audit:onchain-idl": "node scripts/audit-onchain-idl.mjs",
    "preflight:mainnet": "node scripts/preflight-mainnet.mjs",
    "smoke:devnet:sol": "node scripts/devnet-smoke-sol.js",
    "smoke:devnet:usdc": "node scripts/devnet-smoke-usdc.js",
    "verify:local": "yarn verify:idl && cargo fmt --check && yarn lint"
  },
  "socket": {
    "ignore": [
      "network-access"
    ]
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
